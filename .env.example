PORT=3000
NODE_ENV=production

# Recommended: one secret per BDS/streamer instance.
# server_id used in /v1/sessions/register must exist in this JSON object.
BUBBLE_SERVER_KEYS={"bedrock-streamer-a":"change-me-a","bedrock-streamer-b":"change-me-b"}

# Optional fallback for quick tests only. If BUBBLE_SERVER_KEYS is set, prefer per-server keys.
BUBBLE_SERVER_KEY=

# MVP timings
BUBBLE_POLL_MS=200
BUBBLE_PLAYER_TTL_MS=2500
BUBBLE_SESSION_TTL_MS=60000
BUBBLE_HEARTBEAT_MS=10000
BUBBLE_TOKEN_TTL_MS=1800000

# Sync / interest management
BUBBLE_AOI_RADIUS_BU=96
BUBBLE_MAX_REMOTES=64
BUBBLE_SYNC_RATE_PER_SEC=15
BUBBLE_REGISTER_RATE_PER_MIN=30

# Optional admin/debug secret for snapshot route.
BUBBLE_ADMIN_KEY=change-admin-key
